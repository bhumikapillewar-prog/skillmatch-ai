# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Leave as mongodb://localhost:27017/skillmatch if local MongoDB is running.
# If MongoDB is not running, SkillMatch AI automatically falls back to safe in-memory persistence for seamless evaluation.
MONGODB_URI=mongodb://localhost:27017/skillmatch

# JWT Authentication Secret
JWT_SECRET=super_secret_skillmatch_jwt_key_change_in_production_928374
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Optional but recommended for full LLM analysis)
# If left blank, the built-in deterministic NLP engine handles parsing and scoring.
GEMINI_API_KEY=

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Privacy & Retention Configuration
DATA_RETENTION_DAYS=90
ENABLE_PII_LOG_MASKING=true
